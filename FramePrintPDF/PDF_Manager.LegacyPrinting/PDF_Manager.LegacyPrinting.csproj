<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PDF_Manager.LegacyPrinting</AssemblyName>
    <RootNamespace>PDF_Manager</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PDF_Manager\PrintInput.cs" Link="PrintInput.cs" />
    <Compile Include="..\PDF_Manager\PrintData.cs" Link="PrintData.cs" />
    <Compile Include="..\PDF_Manager\IPrintable.cs" Link="IPrintable.cs" />
    <Compile Include="..\PDF_Manager\PrintableBaseA.cs" Link="PrintableBaseA.cs" />
    <Compile Include="..\PDF_Manager\PrintableBaseB.cs" Link="PrintableBaseB.cs" />
    <Compile Include="..\PDF_Manager\PrintableBaseC.cs" Link="PrintableBaseC.cs" />
    <Compile
      Include="..\PDF_Manager\Printing\**\*.cs"
      Exclude="..\PDF_Manager\Printing\PrintDiagram\KAJYU_ZU23.cs"
      Link="Printing\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\PDF_Manager\fonts\MS Gothic.ttf"
      Link="fonts\MS Gothic.ttf"
      LogicalName="PDF_Manager.fonts.MS Gothic.ttf" />
    <EmbeddedResource
      Include="..\PDF_Manager\fonts\MS Mincho.ttf"
      Link="fonts\MS Mincho.ttf"
      LogicalName="PDF_Manager.fonts.MS Mincho.ttf" />
    <EmbeddedResource
      Include="..\PDF_Manager\fonts\simsun.ttf"
      Link="fonts\simsun.ttf"
      LogicalName="PDF_Manager.fonts.simsun.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="PdfSharpCore" Version="1.3.9" />
  </ItemGroup>

</Project>
