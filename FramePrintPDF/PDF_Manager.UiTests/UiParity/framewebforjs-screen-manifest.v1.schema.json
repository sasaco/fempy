{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameweb.local/schemas/framewebforjs-screen-manifest.v1.schema.json",
  "title": "FrameWebforJS screen parity manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "sourceRevision",
    "sources",
    "approvedExclusions",
    "shell",
    "routes",
    "overlays",
    "printStates",
    "referenceCaptures"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "sourceRevision": { "type": "string", "minLength": 7 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvedExclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "shell": { "$ref": "#/$defs/shell" },
    "routes": {
      "type": "array",
      "minItems": 23,
      "items": { "$ref": "#/$defs/route" }
    },
    "overlays": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/overlay" }
    },
    "printStates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/printState" }
    },
    "referenceCaptures": {
      "type": "string",
      "pattern": "reference-captures\\.v1\\.json$"
    }
  },
  "$defs": {
    "mappingKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9_]+)+$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingKey", "order", "kind", "defaultState", "action", "transition"],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "order": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1 },
        "defaultState": { "type": "string", "minLength": 1 },
        "condition": { "type": "string" },
        "action": { "type": "string", "minLength": 1 },
        "transition": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["implemented", "approved-exclusion"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingKey",
        "key",
        "order",
        "group",
        "kind",
        "defaultValue",
        "readOnly",
        "visibleWhen",
        "csharpTableKey",
        "csharpColumnId"
      ],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "key": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "group": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["text", "number", "boolean", "choice", "dynamic-number", "result"] },
        "defaultValue": {},
        "readOnly": { "type": "boolean" },
        "visibleWhen": { "enum": ["always", "2d", "3d", "moving-load", "calculated"] },
        "csharpTableKey": { "type": "string", "minLength": 1 },
        "csharpColumnId": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingKey",
        "family",
        "angularRoute",
        "angularComponent",
        "csharpRouteId",
        "navigationKey",
        "defaultPanelVisible",
        "tableKeys",
        "fields",
        "actions",
        "transitions"
      ],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "family": { "enum": ["input", "result"] },
        "angularRoute": { "type": "string", "minLength": 1 },
        "angularComponent": { "type": "string", "pattern": "Component$" },
        "csharpRouteId": { "type": "string", "minLength": 1 },
        "navigationKey": { "type": "string", "minLength": 1 },
        "defaultPanelVisible": { "type": "boolean" },
        "tableKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "transitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingKey", "kind", "angularOutlet", "csharpOverlayKind", "controls"],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "kind": { "type": "string", "minLength": 1 },
        "angularOutlet": { "type": ["string", "null"] },
        "csharpOverlayKind": { "type": "string", "minLength": 1 },
        "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
      }
    },
    "printState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingKey", "mode", "order", "enabledWhen", "nestedControls"],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "mode": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "enabledWhen": { "enum": ["always", "calculated", "3d"] },
        "nestedControls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingKey", "reason", "approvedScope"],
      "properties": {
        "mappingKey": { "$ref": "#/$defs/mappingKey" },
        "reason": { "type": "string", "minLength": 1 },
        "approvedScope": { "enum": ["login", "authenticated-mypage", "authenticated-logout"] }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "anonymousMenu", "navigation", "optionalHeaderStates"],
      "properties": {
        "hierarchy": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/control" } },
        "anonymousMenu": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/control" } },
        "navigation": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/control" } },
        "optionalHeaderStates": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/control" } }
      }
    }
  }
}
