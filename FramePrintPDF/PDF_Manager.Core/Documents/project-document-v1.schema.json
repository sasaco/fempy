{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameweb.local/contracts/project-document-v1.schema.json",
  "title": "FrameWeb Project Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "metadata", "model", "loads", "derived_results", "moving_loads"],
  "properties": {
    "kind": { "const": "frameweb_project" },
    "schema_version": { "const": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "model": { "$ref": "#/$defs/model" },
    "loads": { "$ref": "#/$defs/loads" },
    "derived_results": { "type": "array", "items": { "$ref": "#/$defs/derivedResult" } },
    "moving_loads": { "type": "array", "items": { "$ref": "#/$defs/movingLoad" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "number": { "type": "number" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "author", "unit_system"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "unit_system": { "$ref": "#/$defs/id" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "members", "supports"],
      "properties": {
        "dimension": { "enum": ["2d", "3d"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/frameSection" } },
        "element_property_sets": { "type": "array", "items": { "$ref": "#/$defs/elementPropertySet" } },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "rigid_zones": { "type": "array", "items": { "$ref": "#/$defs/rigidZone" } },
        "supports": { "type": "array", "items": { "$ref": "#/$defs/support" } },
        "support_sets": { "type": "array", "items": { "$ref": "#/$defs/supportSet" } },
        "panels": { "type": "array", "items": { "$ref": "#/$defs/panel" } },
        "joint_release_sets": { "type": "array", "items": { "$ref": "#/$defs/jointReleaseSet" } },
        "notice_points": { "type": "array", "items": { "$ref": "#/$defs/noticePoint" } },
        "member_spring_sets": { "type": "array", "items": { "$ref": "#/$defs/memberSpringSet" } }
      }
    },
    "loads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "nodal_loads"],
      "properties": {
        "cases": { "type": "array", "items": { "$ref": "#/$defs/loadCase" } },
        "nodal_loads": { "type": "array", "items": { "$ref": "#/$defs/nodalLoad" } },
        "prescribed_displacements": { "type": "array", "items": { "$ref": "#/$defs/prescribedDisplacement" } },
        "member_loads": { "type": "array", "items": { "$ref": "#/$defs/memberLoad" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "z"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "$ref": "#/$defs/number" },
        "y": { "$ref": "#/$defs/number" },
        "z": { "$ref": "#/$defs/number" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_i", "node_j"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node_i": { "$ref": "#/$defs/id" },
        "node_j": { "$ref": "#/$defs/id" },
        "section_id": { "type": ["string", "null"], "pattern": ".*\\S.*" },
        "rotation_degrees": { "$ref": "#/$defs/number" },
        "shear_correction": { "type": "boolean" }
      }
    },
    "frameSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "youngs_modulus", "poisson_ratio", "shear_modulus", "area", "moment_of_inertia_y", "moment_of_inertia_z", "torsion_constant"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "youngs_modulus": { "type": "number", "exclusiveMinimum": 0 },
        "poisson_ratio": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
        "shear_modulus": { "type": "number", "exclusiveMinimum": 0 },
        "area": { "type": "number", "exclusiveMinimum": 0 },
        "moment_of_inertia_y": { "type": "number", "exclusiveMinimum": 0 },
        "moment_of_inertia_z": { "type": "number", "exclusiveMinimum": 0 },
        "torsion_constant": { "type": "number", "exclusiveMinimum": 0 },
        "thermal_expansion_coefficient": { "$ref": "#/$defs/number" },
        "density": { "type": "number", "minimum": 0 },
        "panel_thickness": { "type": "number", "minimum": 0 }
      }
    },
    "elementPropertySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/frameSection" } }
      }
    },
    "rigidZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_id", "i_length", "j_length", "section_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "member_id": { "$ref": "#/$defs/id" },
        "i_length": { "type": "number", "minimum": 0 },
        "j_length": { "type": "number", "minimum": 0 },
        "section_id": { "$ref": "#/$defs/id" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_id", "fix_x", "fix_y", "fix_z", "fix_rx", "fix_ry", "fix_rz"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" },
        "fix_x": { "type": "boolean" },
        "fix_y": { "type": "boolean" },
        "fix_z": { "type": "boolean" },
        "fix_rx": { "type": "boolean" },
        "fix_ry": { "type": "boolean" },
        "fix_rz": { "type": "boolean" }
      }
    },
    "supportSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/supportCondition" } }
      }
    },
    "supportCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_id", "tx", "ty", "tz", "rx", "ry", "rz"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" },
        "tx": { "$ref": "#/$defs/number" }, "ty": { "$ref": "#/$defs/number" },
        "tz": { "$ref": "#/$defs/number" }, "rx": { "$ref": "#/$defs/number" },
        "ry": { "$ref": "#/$defs/number" }, "rz": { "$ref": "#/$defs/number" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section_id", "node_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "section_id": { "$ref": "#/$defs/id" },
        "node_ids": { "type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "jointReleaseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/jointRelease" } }
      }
    },
    "jointRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_id", "connect_xi", "connect_yi", "connect_zi", "connect_xj", "connect_yj", "connect_zj"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "member_id": { "$ref": "#/$defs/id" },
        "connect_xi": { "type": "boolean" }, "connect_yi": { "type": "boolean" },
        "connect_zi": { "type": "boolean" }, "connect_xj": { "type": "boolean" },
        "connect_yj": { "type": "boolean" }, "connect_zj": { "type": "boolean" }
      }
    },
    "noticePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_id", "distance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "member_id": { "$ref": "#/$defs/id" },
        "distance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "memberSpringSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/memberSpring" } }
      }
    },
    "memberSpring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_id", "tx", "ty", "tz", "tr"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "member_id": { "$ref": "#/$defs/id" },
        "tx": { "$ref": "#/$defs/number" }, "ty": { "$ref": "#/$defs/number" },
        "tz": { "$ref": "#/$defs/number" }, "tr": { "$ref": "#/$defs/number" }
      }
    },
    "loadCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "symbol"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
        "symbol": { "$ref": "#/$defs/id" }, "element_set_id": { "$ref": "#/$defs/id" },
        "support_set_id": { "$ref": "#/$defs/id" }, "member_spring_set_id": { "$ref": "#/$defs/id" },
        "joint_set_id": { "$ref": "#/$defs/id" },
        "moving_load_pitch": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "nodalLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "node_id", "fx", "fy", "fz", "mx", "my", "mz"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" }, "fx": { "$ref": "#/$defs/number" },
        "fy": { "$ref": "#/$defs/number" }, "fz": { "$ref": "#/$defs/number" },
        "mx": { "$ref": "#/$defs/number" }, "my": { "$ref": "#/$defs/number" },
        "mz": { "$ref": "#/$defs/number" }
      }
    },
    "prescribedDisplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "node_id", "dx", "dy", "dz", "rx", "ry", "rz"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" }, "dx": { "$ref": "#/$defs/number" },
        "dy": { "$ref": "#/$defs/number" }, "dz": { "$ref": "#/$defs/number" },
        "rx": { "$ref": "#/$defs/number" }, "ry": { "$ref": "#/$defs/number" },
        "rz": { "$ref": "#/$defs/number" }
      }
    },
    "memberLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "member_id", "kind", "direction", "l1", "l2", "p1", "p2"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" },
        "member_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["point_force", "point_moment", "distributed_force", "thermal"] },
        "direction": { "enum": ["local_x", "local_y", "local_z", "global_x", "global_y", "global_z"] },
        "l1": { "$ref": "#/$defs/number" }, "l2": { "$ref": "#/$defs/number" },
        "p1": { "$ref": "#/$defs/number" }, "p2": { "$ref": "#/$defs/number" }
      }
    },
    "derivedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "terms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["define", "combine", "pickup"] },
        "terms": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "factor"],
            "properties": { "source_id": { "$ref": "#/$defs/id" }, "factor": { "$ref": "#/$defs/number" } }
          }
        }
      }
    },
    "movingLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "case_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
        "case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
