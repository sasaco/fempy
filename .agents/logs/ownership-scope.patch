++++++def envelope(compressed: bytes, wire_format: str) -> bytes:
++++++    values = list(compressed)
++++++    text = (
++++++        json.dumps(values)
++++++        if wire_format == "json-array"
++++++        else ",".join(str(value) for value in values)
++++++    )
++++++    return outer_body(text)
