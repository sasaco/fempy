++        ("expression", "1+1"),
++        ("python-import", "__import__('os').getcwd()"),
++    ]
++]
++
++
++@pytest.mark.parametrize("text", INVALID_OUTER)
++def test_rejects_invalid_outer_byte_sequences(text: str) -> None:
