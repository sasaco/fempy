-    raw = _flag_value(command, "--prompt-file")
-    if not raw:
-        return None
-    path = Path(raw)
-    try:
-        return path.read_text(encoding="utf-8")
-    except (OSError, UnicodeDecodeError):
-        return f"[prompt file unavailable: {path}]"
-
-
-def parse_wrapper_result(output: str) -> dict | None:
