@@ -0,0 +1,215 @@
+[CmdletBinding()]
+param(
+    [switch]$AgentOnly,
+    [switch]$IncludeOptionalProduct
+)
+
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+$script:Passed = 0
+$script:Failed = 0
+$script:Skipped = 0
+
+$AgentDir = Split-Path -Parent $MyInvocation.MyCommand.Path
+$Root = (Resolve-Path (Join-Path $AgentDir '..')).Path
+$PythonPrefix = @(
+    'uv', 'run', '--project', 'FrameWeb', '--locked', '--extra', 'dev',
+    'python'
+)
+$env:PYTHONDONTWRITEBYTECODE = '1'
+
+function Invoke-CommandLine {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][string[]]$Command
+    )
+
+    Write-Host "RUN : $Name"
+    Write-Host ("      " + ($Command -join ' '))
+    $Executable = $Command[0]
+    $Arguments = @()
+    if ($Command.Count -gt 1) {
+        $Arguments = $Command[1..($Command.Count - 1)]
+    }
+    & $Executable @Arguments
+    if ($LASTEXITCODE -eq 0) {
+        Write-Host "PASS: $Name" -ForegroundColor Green
+        $script:Passed += 1
+        return $true
+    }
+    Write-Host "FAIL: $Name (exit $LASTEXITCODE)" -ForegroundColor Red
+    $script:Failed += 1
+    return $false
+}
+
+function Invoke-Predicate {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][scriptblock]$Check
+    )
+
+    Write-Host "RUN : $Name"
+    try {
+        $Ok = & $Check
+    }
+    catch {
+        Write-Host "  $($_.Exception.Message)" -ForegroundColor Red
+        $Ok = $false
+    }
+    if ($Ok) {
+        Write-Host "PASS: $Name" -ForegroundColor Green
+        $script:Passed += 1
+        return $true
+    }
+    Write-Host "FAIL: $Name" -ForegroundColor Red
+    $script:Failed += 1
+    return $false
+}
+
+function Skip-Gate {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][string]$Reason
+    )
+
+    Write-Host "SKIP: $Name ($Reason)" -ForegroundColor Yellow
+    $script:Skipped += 1
+}
+
+function Test-LiveScriptReferences {
+    $Excluded = '\\(logs|checkpoints|research|reviews|plans)\\'
+    $Patterns = @(
+        '\.agents/skills/[A-Za-z0-9_./-]+\.(py|ps1|sh)',
+        '\.agents/check\.(ps1|sh)'
+    )
+    $Missing = [System.Collections.Generic.List[string]]::new()
+    $Markdown = Get-ChildItem -LiteralPath (Join-Path $Root '.agents') -Recurse -File -Filter '*.md' |
+        Where-Object { $_.FullName -notmatch $Excluded }
+    $RootDocs = @('AGENTS.md', 'README.md') |
+        ForEach-Object { Join-Path $Root $_ } |
+        Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } |
+        ForEach-Object { Get-Item -LiteralPath $_ }
+
+    foreach ($File in @($Markdown) + @($RootDocs)) {
+        foreach ($Pattern in $Patterns) {
+            foreach ($Match in (Select-String -LiteralPath $File.FullName -Pattern $Pattern -AllMatches)) {
+                foreach ($Value in $Match.Matches.Value) {
+                    $Candidate = Join-Path $Root ($Value.Replace('/', '\'))
+                    if (-not (Test-Path -LiteralPath $Candidate -PathType Leaf)) {
+                        $Missing.Add("$($File.FullName): $Value")
+                    }
+                }
+            }
+        }
+    }
+    if ($Missing.Count -gt 0) {
+        $Missing | Sort-Object -Unique | ForEach-Object { Write-Host "  Missing: $_" }
+        return $false
+    }
+    return $true
+}
+
+function Test-ForeignReferences {
+    $Targets = @(
+        (Join-Path $Root '.agents/STATE.md'),
+        (Join-Path $Root '.agents/docs/DESIGN.md'),
+        (Join-Path $Root 'PROGRESS.md')
+    ) | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf }
+    $Pattern = 'tick.?replay|duckdb|minute-context|daily-context|stocks_daily|SMA25|SMA200|src/tickreplay'
+    $Matches = Select-String -LiteralPath $Targets -Pattern $Pattern -AllMatches -CaseSensitive:$false
+    if ($Matches) {
+        $Matches | ForEach-Object { Write-Host "  $($_.Path):$($_.LineNumber): $($_.Line.Trim())" }
+        return $false
+    }
+    return $true
+}
+
+function Test-NoAgentCaches {
+    $Pyc = @(Get-ChildItem -LiteralPath $AgentDir -Recurse -Force -File -Filter '*.pyc')
+    $CacheDirs = @(Get-ChildItem -LiteralPath $AgentDir -Recurse -Force -Directory -Filter '__pycache__')
+    foreach ($Item in @($Pyc) + @($CacheDirs)) {
+        Write-Host "  Cache remains: $($Item.FullName)"
+    }
+    return ($Pyc.Count -eq 0 -and $CacheDirs.Count -eq 0)
+}
+
+if ($AgentOnly -and $IncludeOptionalProduct) {
+    throw '-AgentOnly and -IncludeOptionalProduct cannot be used together.'
+}
+
+Push-Location $Root
+try {
+    Invoke-CommandLine 'agent pytest' ($PythonPrefix + @('-m', 'pytest', '.agents/tests', '-q')) | Out-Null
+
+    $DetectorCommand = $PythonPrefix + @('.agents/skills/init/detect_stack.py', '--project-root', '.')
+    Write-Host 'RUN : repository detector'
+    $DetectorOutput = & $DetectorCommand[0] $DetectorCommand[1..($DetectorCommand.Count - 1)] 2>&1
+    $DetectorExit = $LASTEXITCODE
+    $DetectorText = $DetectorOutput -join [Environment]::NewLine
+    Write-Host $DetectorText
+    $DetectorReport = $null
+    try {
+        $DetectorReport = $DetectorText | ConvertFrom-Json
+    }
+    catch {
+        Write-Host "  Detector did not emit JSON: $($_.Exception.Message)" -ForegroundColor Red
+    }
+    if ($DetectorExit -eq 0 -and $null -ne $DetectorReport -and $DetectorReport.ok) {
+        Write-Host 'PASS: repository detector' -ForegroundColor Green
+        $script:Passed += 1
+    }
+    else {
+        Write-Host "FAIL: repository detector (exit $DetectorExit)" -ForegroundColor Red
+        $script:Failed += 1
+    }
+
+    Invoke-CommandLine 'STATE contract' ($PythonPrefix + @(
+        '.agents/skills/_shared/validate_doc.py', '--contract', 'state-doc',
+        '--file', '.agents/STATE.md'
+    )) | Out-Null
+    Invoke-CommandLine 'DESIGN contract' ($PythonPrefix + @(
+        '.agents/skills/_shared/validate_doc.py', '--contract', 'design-doc',
+        '--file', '.agents/docs/DESIGN.md'
+    )) | Out-Null
+    Invoke-CommandLine 'plan contract' ($PythonPrefix + @(
+        '.agents/skills/_shared/validate_doc.py', '--contract', 'plan-doc',
+        '--file', '.agents/docs/plans/agents-repository-alignment.md'
+    )) | Out-Null
+
+    Invoke-Predicate 'live script references resolve' { Test-LiveScriptReferences } | Out-Null
+    Invoke-Predicate 'foreign project references absent' { Test-ForeignReferences } | Out-Null
+    Invoke-Predicate 'agent caches absent' { Test-NoAgentCaches } | Out-Null
+    Invoke-CommandLine 'git diff --check' @('git', 'diff', '--check') | Out-Null
+
+    if ($AgentOnly) {
+        Skip-Gate 'product gates' 'AgentOnly requested'
+    }
+    elseif ($null -eq $DetectorReport) {
+        Write-Host 'FAIL: product gates unavailable because detector JSON was invalid' -ForegroundColor Red
+        $script:Failed += 1
+    }
+    else {
+        $ProductGates = @($DetectorReport.gates | Where-Object { $_.classification -eq 'product' })
+        if ($ProductGates.Count -eq 0) {
+            Write-Host 'FAIL: no product gates declared in repository.toml' -ForegroundColor Red
+            $script:Failed += 1
+        }
+        foreach ($Gate in $ProductGates) {
+            if ($Gate.optional -and -not $IncludeOptionalProduct) {
+                Skip-Gate $Gate.id 'optional product gate; use -IncludeOptionalProduct'
+                continue
+            }
+            Invoke-CommandLine ("product: " + $Gate.id) ([string[]]$Gate.command) | Out-Null
+        }
+    }
+}
+finally {
+    Pop-Location
+}
+
+Write-Host ''
+Write-Host "Results: $script:Passed passed, $script:Failed failed, $script:Skipped skipped"
+if ($script:Failed -gt 0) {
+    exit 1
+}
+exit 0
