+def _tracked_files(root: Path, pathspec: str) -> list[str]:
+    try:
+        completed = subprocess.run(
+            ["git", "ls-files", "-z", "--", pathspec],
+            cwd=root,
+            capture_output=True,
+            timeout=30,
+        )
